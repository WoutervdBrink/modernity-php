{
  "name": "knevelina/modernity-php",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Wouter van den Brink",
      "email": "git@woutervdb.com"
    }
  ],
  "support": {
    "issues": "https://github.com/woutervdbrink/modernity-php/issues",
    "source": "https://github.com/woutervdbrink/modernity-php"
  },
  "require": {
    "php": "^8.5",
    "ext-dom": "*",
    "ext-ds": "*",
    "graham-campbell/github": "^13.1",
    "illuminate/database": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/redis": "^13.0",
    "illuminate/view": "^13.0",
    "laravel-zero/framework": "^13.0",
    "nikic/php-parser": "^5.9",
    "spatie/laravel-data": "^4.23"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "haydenpierce/class-finder": "^0.6.0",
    "laravel/pint": "^1.25",
    "pestphp/pest": "^5.2",
    "phpstan/phpstan": "^2.2",
    "vimeo/psalm": "^6.18"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "exclude-from-classmap": [
      "/tests/Fixtures/**"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "bin": [
    "application"
  ]
}
